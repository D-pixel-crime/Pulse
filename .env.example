# Local development configuration defaults for Pulse.

# Service-to-service API key for /api/v1/ routes (minimum 32 characters).
# Required at startup. Generate a random secret key locally before running:
#   openssl rand -hex 32
PULSE_API_KEY=

# Application HTTP address (defaults to 127.0.0.1:8080 when running directly on host;
# docker-compose.yml sets APP_ADDR=0.0.0.0:8080 inside the container and publishes 127.0.0.1:8080:8080).
APP_ADDR=127.0.0.1:8080

# PostgreSQL connection URL pointing to the Supabase IPv4-compatible shared Session Pooler (port 5432).
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=

# Per-instance maximum database connection cap (valid range 1-20, default 5).
# MinConns is set to 0 so idle replicas do not reserve unnecessary connections.
# Connection budget:
#   maximum possible application connections = application instance count × DB_MAX_CONNS
# Keep this below the database/pooler connection allowance, leaving room
# for administration and maintenance.
DB_MAX_CONNS=5

# Scheduler and worker pool configuration (queue capacity equals WORKER_COUNT)
WORKER_COUNT=5
SCHEDULER_POLL_INTERVAL=1s
