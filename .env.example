# Local development-only configuration defaults for Pulse.

# Service-to-service API key for /api/v1/ routes (minimum 32 characters).
# Required at startup. Generate a random secret key locally before running:
#   openssl rand -hex 32
PULSE_API_KEY=

# Application HTTP address (strictly binds to localhost when running directly on host;
# docker-compose.yml sets APP_ADDR=0.0.0.0:8080 inside the container and publishes 127.0.0.1:8080:8080)
APP_ADDR=127.0.0.1:8080

# PostgreSQL connection URL using local development-only demo credentials (pulse/pulse)
# Note: docker-compose.yml overrides this inside the app container to point to the "db" service (@db:5432).
DATABASE_URL=postgres://pulse:pulse@localhost:5432/pulse?sslmode=disable

# Per-instance maximum database connection cap (valid range 1-20, default 5).
# MinConns is set to 0 so idle replicas do not reserve unnecessary connections.
# Connection budget:
#   maximum possible application connections = application instance count × DB_MAX_CONNS
# Keep this below the Supabase pooler's/database's connection allowance, leaving room
# for administration and migrations.
DB_MAX_CONNS=5

# Scheduler and worker pool configuration
WORKER_COUNT=5
QUEUE_CAPACITY=100
SCHEDULER_POLL_INTERVAL=1s

# Monitor default intervals and timeouts
DEFAULT_MONITOR_INTERVAL=60s
DEFAULT_CHECK_TIMEOUT=5s
